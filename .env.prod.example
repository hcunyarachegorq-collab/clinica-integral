# ==============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (VPS) - SISTEMA CLÍNICO INTEGRAL
# Copia este archivo a '.env.prod' en tu servidor y completa los valores reales:
#   cp .env.prod.example .env.prod
# ==============================================================================

# Dominio público configurado con registro DNS tipo A apuntando al VPS
DOMAIN=clinica.tudominio.com

# Correo de contacto del administrador para avisos de renovación de Let's Encrypt
CERTBOT_EMAIL=admin@tudominio.com

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=clinica_prod_user
# Genera una contraseña segura y aleatoria (ej: openssl rand -base64 24)
POSTGRES_PASSWORD=genera_una_clave_segura_aqui_prod_2026!
POSTGRES_DB=clinica_prod_db

# ------------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD JWT
# ------------------------------------------------------------------------------
# Llave secreta para firmar tokens (mínimo 32 caracteres criptográficamente seguros)
JWT_SECRET=super_secret_jwt_key_production_2026_genera_una_clave_larga_aqui

# ------------------------------------------------------------------------------
# RED Y CORS
# ------------------------------------------------------------------------------
# Origen permitido para solicitudes web del navegador (tu dominio con https://)
CORS_ORIGIN=https://clinica.tudominio.com

# URL pública que consumirá el cliente frontend web en Next.js
# Al usar Nginx como reverse proxy, '/api' permite llamadas relativas en el mismo dominio
NEXT_PUBLIC_API_URL=/api
