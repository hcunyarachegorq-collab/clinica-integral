datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
}

enum LabOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role          @default(PATIENT)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doctorProfile  DoctorProfile?
  appointments   Appointment[]
  medicalRecords MedicalRecord[] @relation("PatientRecords")
  notifications  Notification[]
  reviews        DoctorReview[]  @relation("PatientReviews")
  labOrders      LabOrder[]      @relation("PatientLabOrders")

  @@map("users")
}

model Specialty {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  iconName    String?
  doctors     DoctorProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("specialties")
}

model DoctorProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId     String
  specialty       Specialty        @relation(fields: [specialtyId], references: [id])
  licenseNumber   String           @unique
  bio             String?
  consultationFee Decimal          @db.Decimal(10, 2)
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  blockedDates    DoctorBlockedDate[]
  reviews         DoctorReview[]
  labOrders       LabOrder[]          @relation("DoctorLabOrders")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("doctor_profiles")
}

model DoctorSchedule {
  id                  String        @id @default(uuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int           // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  startTime           String        // Ej: "08:00"
  endTime             String        // Ej: "17:00"
  slotDurationMinutes Int           @default(30)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("doctor_schedules")
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        AppointmentStatus @default(PENDING)
  reason        String
  notes         String?

  // Control de turnos y sala de espera
  queueCode      String?
  consultingRoom String?
  calledAt       DateTime?

  // Control de pagos
  paymentStatus PaymentStatus     @default(UNPAID)
  paymentMethod PaymentMethod?
  amountPaid    Decimal?          @db.Decimal(10, 2)
  paidAt        DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  medicalRecord MedicalRecord?
  triage        Triage?
  review        DoctorReview?

  @@map("appointments")
}

model Triage {
  id               String      @id @default(uuid())
  appointmentId    String      @unique
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  bloodPressure    String      // Ej: "120/80"
  heartRate        Int         // lpm
  temperature      Float       // °C
  weightKg         Float       // kg
  heightCm         Float       // cm
  oxygenSaturation Int         // %
  allergies        String?
  notes            String?
  createdAt        DateTime    @default(now())

  @@map("triages")
}

model MedicalRecord {
  id                String              @id @default(uuid())
  appointmentId     String              @unique
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId         String
  patient           User                @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis         String
  prescription      String
  notes             String?
  pharmacyTotal     Float               @default(0)
  pharmacyPaid      Boolean             @default(false)
  restDays          Int                 @default(0)
  restStartDate     DateTime?
  restEndDate       DateTime?
  cie10Code         String?
  attachments       MedicalAttachment[]
  prescriptionItems PrescriptionItem[]
  labOrders         LabOrder[]
  createdAt         DateTime            @default(now())

  @@map("medical_records")
}

model DoctorBlockedDate {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      String        // Formato "YYYY-MM-DD"
  reason    String?
  createdAt DateTime      @default(now())

  @@unique([doctorId, date])
  @@map("doctor_blocked_dates")
}

model MedicalAttachment {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  fileName        String
  fileType        String        // Ej: "application/pdf", "image/png"
  fileDataUrl     String        @db.Text
  createdAt       DateTime      @default(now())

  @@map("medical_attachments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // "APPOINTMENT", "MEDICAL_RECORD", "SYSTEM"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model DoctorReview {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User          @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating        Int           // 1 a 5
  comment       String?
  createdAt     DateTime      @default(now())

  @@map("doctor_reviews")
}

model Medication {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  presentation      String
  category          String
  price             Float
  stock             Int
  minStock          Int                @default(10)
  isActive          Boolean            @default(true)
  prescriptionItems PrescriptionItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("medications")
}

model PrescriptionItem {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  medicationId    String
  medication      Medication    @relation(fields: [medicationId], references: [id])
  quantity        Int
  dosage          String
  unitPrice       Float
  subtotal        Float
  createdAt       DateTime      @default(now())

  @@map("prescription_items")
}

model LabCatalogItem {
  id        String     @id @default(uuid())
  code      String     @unique // Ej: LAB-001, IMG-001
  name      String
  category  String     // "Laboratorio", "Imágenes", "Cardiología Diagnóstica"
  price     Float
  isActive  Boolean    @default(true)
  orders    LabOrder[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("lab_catalog_items")
}

model LabOrder {
  id               String          @id @default(uuid())
  medicalRecordId  String?
  medicalRecord    MedicalRecord?  @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patientId        String
  patient          User            @relation("PatientLabOrders", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           DoctorProfile   @relation("DoctorLabOrders", fields: [doctorId], references: [id], onDelete: Cascade)
  catalogItemId    String
  catalogItem      LabCatalogItem  @relation(fields: [catalogItemId], references: [id])
  notes            String?
  status           LabOrderStatus  @default(PENDING)
  resultSummary    String?         @db.Text
  resultFileBase64 String?         @db.Text
  resultFileName   String?
  price            Float
  paid             Boolean         @default(false)
  createdAt        DateTime        @default(now())
  completedAt      DateTime?

  @@map("lab_orders")
}

model ObservationBed {
  id                 String    @id @default(uuid())
  code               String    @unique // BOX-01 a BOX-06
  name               String    // "Box 1 - Urgencias", "Camilla 2 - Observación"
  status             BedStatus @default(AVAILABLE)
  currentPatientId   String?
  currentPatientName String?
  reason             String?
  procedure          String?   // "Nebulización continua", "Vía intravenosa", "Curación mayor"
  fee                Float     @default(0)
  paid               Boolean   @default(false)
  admittedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("observation_beds")
}

model BillingReceipt {
  id                 String   @id @default(uuid())
  receiptNumber      String   @unique // BOL-2026-XXXX
  patientId          String
  patientName        String
  cashierId          String?
  cashierName        String?
  paymentMethod      String   // EFECTIVO, YAPE_PLIN, TARJETA, TRANSFERENCIA
  totalAmount        Float
  consultationTotal  Float    @default(0)
  pharmacyTotal      Float    @default(0)
  labTotal           Float    @default(0)
  topicTotal         Float    @default(0)
  itemsJson          String   @db.Text
  createdAt          DateTime @default(now())

  @@map("billing_receipts")
}

