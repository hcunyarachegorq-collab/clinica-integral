datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role          @default(PATIENT)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doctorProfile  DoctorProfile?
  appointments   Appointment[]
  medicalRecords MedicalRecord[] @relation("PatientRecords")
  notifications  Notification[]
  reviews        DoctorReview[]  @relation("PatientReviews")

  @@map("users")
}

model Specialty {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  iconName    String?
  doctors     DoctorProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("specialties")
}

model DoctorProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId     String
  specialty       Specialty        @relation(fields: [specialtyId], references: [id])
  licenseNumber   String           @unique
  bio             String?
  consultationFee Decimal          @db.Decimal(10, 2)
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  blockedDates    DoctorBlockedDate[]
  reviews         DoctorReview[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("doctor_profiles")
}

model DoctorSchedule {
  id                  String        @id @default(uuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int           // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  startTime           String        // Ej: "08:00"
  endTime             String        // Ej: "17:00"
  slotDurationMinutes Int           @default(30)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("doctor_schedules")
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        AppointmentStatus @default(PENDING)
  reason        String
  notes         String?

  // Control de pagos
  paymentStatus PaymentStatus     @default(UNPAID)
  paymentMethod PaymentMethod?
  amountPaid    Decimal?          @db.Decimal(10, 2)
  paidAt        DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  medicalRecord MedicalRecord?
  triage        Triage?
  review        DoctorReview?

  @@map("appointments")
}

model Triage {
  id               String      @id @default(uuid())
  appointmentId    String      @unique
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  bloodPressure    String      // Ej: "120/80"
  heartRate        Int         // lpm
  temperature      Float       // °C
  weightKg         Float       // kg
  heightCm         Float       // cm
  oxygenSaturation Int         // %
  allergies        String?
  notes            String?
  createdAt        DateTime    @default(now())

  @@map("triages")
}

model MedicalRecord {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User          @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis     String
  prescription  String
  notes         String?
  attachments   MedicalAttachment[]
  createdAt     DateTime      @default(now())

  @@map("medical_records")
}

model DoctorBlockedDate {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      String        // Formato "YYYY-MM-DD"
  reason    String?
  createdAt DateTime      @default(now())

  @@unique([doctorId, date])
  @@map("doctor_blocked_dates")
}

model MedicalAttachment {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  fileName        String
  fileType        String        // Ej: "application/pdf", "image/png"
  fileDataUrl     String        @db.Text
  createdAt       DateTime      @default(now())

  @@map("medical_attachments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // "APPOINTMENT", "MEDICAL_RECORD", "SYSTEM"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model DoctorReview {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User          @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating        Int           // 1 a 5
  comment       String?
  createdAt     DateTime      @default(now())

  @@map("doctor_reviews")
}
